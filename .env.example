# Supabase Yapılandırması (https://supabase.com üzerinden ücretsiz proje açabilirsiniz)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Marka ve Mağaza Bilgileri
NEXT_PUBLIC_SITE_NAME=sim-cila
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# İleride eklenecek iyzico API anahtarları (Şimdilik mock arayüz çalışır)
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
